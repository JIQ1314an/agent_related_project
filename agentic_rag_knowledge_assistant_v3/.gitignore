# ============================================================
# 通用 Python / 工程忽略规则（适用于本 Agent 项目）
# 遵循 GitHub 提交规范：
#   - 忽略字节码、缓存、虚拟环境
#   - 忽略含密钥的 .env（保留 .env.example 模板）
#   - 忽略日志、运行时数据库等可重新生成的产物
# ============================================================

# ---- 字节码 / 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量 / 密钥（切勿提交真实密钥；保留 .env.example 模板）----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
logs/

# ---- 数据库（运行时状态，可由脚本/下载重新生成）----
*.db
*.sqlite
*.sqlite3

# ---- 测试 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 操作系统 / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 本项目特有 ----
# 本地配置文件（含运行环境相关设置，避免误提交；以 .env.example 为模板）
config.py
# 临时数据目录
tmp_data/
# 自动生成的评测报告（可由评测脚本重新生成；知识库文档与评测集 data/*.md、data/eval_dataset.json 保留）
data/eval_results_checkpoint.json
data/final_eval_report.json
