# ============================================================
# 通用 Python / 工程忽略规则（适用于本 Agent 项目）
# 遵循 GitHub 提交规范：
#   - 忽略字节码、缓存、虚拟环境
#   - 忽略含密钥的 .env（保留 .env.example 模板）
#   - 忽略日志、运行时数据库等可重新生成的产物
# ============================================================

# ---- 字节码 / 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量 / 密钥（切勿提交真实密钥；保留 .env.example 模板）----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
logs/

# ---- 数据库（运行时状态，可由脚本/下载重新生成）----
*.db
*.sqlite
*.sqlite3

# ---- 测试 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 操作系统 / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 本项目特有 ----
# /learn 运行时自动生成的技能文件（运行时产物，可重新学习生成）
skills/custom_skills/generated_learned_skill.py
