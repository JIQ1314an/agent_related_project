# ==========================================
# 大语言模型 API 配置
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ==========================================
# 海外与全球搜索引擎 (Tavily)
# ==========================================
TAVILY_API_KEY=tvly-xxxxxx

# ==========================================
# 国内深度中文搜索引擎 (博查 AI / Bocha)
# 作用: 深度索引微信公众号、知乎、掘金及国内技术社区
# 申请地址: https://open.bochaai.com
# ==========================================
BOCHA_API_KEY=bocha-xxxxxx


# LangFuse 跟踪配置 (可选，留空则自动关闭)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ==========================================
# 其它可选配置
# ==========================================
MIN_WORD_COUNT=2000
MAX_REVISION_LOOPS=2
LOG_LEVEL=INFO